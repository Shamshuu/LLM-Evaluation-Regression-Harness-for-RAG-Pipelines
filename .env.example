# Optional hosted judge configuration. The default evaluation is offline and deterministic.
OPENAI_API_KEY=your_key_here
LLM_API_KEY=replace_me
LLM_MODEL_ID=local-deterministic-judge-v1

# Vector database connection used by the compose service/documented integration boundary.
VECTOR_DB_HOST=qdrant
VECTOR_DB_PORT=6333
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=rag_eval_documents
